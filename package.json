{
  "name": "binaflow",
  "version": "0.1.0-preview.0",
  "description": "Local workflow orchestrator for coding agents",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "binaflow": "dist/src/cli/index.js"
  },
  "files": [
    "dist/src",
    "dist/web"
  ],
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "node scripts/build-web.mjs",
    "build:bundle": "pnpm run build && node scripts/build-linux-bundle.mjs",
    "build:testrelease": "pnpm run build && node scripts/build-testrelease.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run --project core",
    "test:application": "vitest run --project application",
    "test:cli": "vitest run --project cli",
    "test:tui": "vitest run --project tui",
    "test:web:unit": "vitest run --project web",
    "test:web:install": "playwright install chromium",
    "test:infrastructure": "vitest run --project infrastructure",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related --run",
    "test:e2e": "pnpm run build && vitest run --config vitest.e2e.config.ts",
    "test:integration": "pnpm run test:e2e",
    "test:web": "playwright test",
    "build:windows-bundle": "npm run build && node scripts/build-windows-bundle.mjs",
    "cli": "tsx src/cli/index.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@inkjs/ui": "2.0.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.4.1",
    "commander": "^14.0.1",
    "ink": "7.1.1",
    "ipaddr.js": "2.2.0",
    "marked": "18.0.11",
    "parse5": "7.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "string-width": "8.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.2.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.9",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
