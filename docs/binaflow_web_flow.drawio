<mxfile host="app.diagrams.net">
  <diagram id="web-flow" name="Flujo web propuesto">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1520" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Binaflow web · Flujo propuesto" style="text;html=1;fontSize=25;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="800" height="60" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Uso personal · Una máquina ejecuta; cualquier navegador permite continuar" style="text;html=1;fontSize=14;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="800" height="40" as="geometry"/></mxCell>
        <mxCell id="explore" value="&lt;b&gt;1. Exploración&lt;/b&gt;&lt;br&gt;Chat · repositorio · web" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="plan" value="&lt;b&gt;2. Plan inicial&lt;/b&gt;&lt;br&gt;Archivos y motivos&lt;br&gt;Feedback y aprobación" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="todo" value="&lt;b&gt;3. TODO.md&lt;/b&gt;&lt;br&gt;Tareas detalladas&lt;br&gt;y verificaciones" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="120" height="80" as="geometry"/></mxCell>
        <mxCell id="build" value="&lt;b&gt;4. Ejecutar fases&lt;/b&gt;&lt;br&gt;Avance por tarea&lt;br&gt;Commit por fase" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="520" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="changes" value="&lt;b&gt;5. Revisar cambios&lt;/b&gt;&lt;br&gt;Diff y explicación&lt;br&gt;por archivo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="640" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="qa" value="&lt;b&gt;6. QA&lt;/b&gt;&lt;br&gt;Bugs, prácticas&lt;br&gt;y arquitectura" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="760" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="tickets" value="&lt;b&gt;7. Decidir tickets&lt;/b&gt;&lt;br&gt;Corregir, descartar&lt;br&gt;o aceptar riesgo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="880" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="qa_todo" value="&lt;b&gt;8. QA_TODO.md&lt;/b&gt;&lt;br&gt;Solo soluciones&lt;br&gt;autorizadas" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="400" y="1000" width="120" height="80" as="geometry"/></mxCell>
        <mxCell id="fix" value="&lt;b&gt;9. Corregir&lt;/b&gt;&lt;br&gt;Ejecutar QA_TODO&lt;br&gt;y verificar soluciones" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="1120" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="another_qa" value="¿Otra revisión&lt;br&gt;completa?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="400" y="1240" width="140" height="80" as="geometry"/></mxCell>
        <mxCell id="finish" value="&lt;b&gt;10. Cierre&lt;/b&gt;&lt;br&gt;Aprobación final&lt;br&gt;y resumen de cambios" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="1360" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="host_note" value="&lt;b&gt;La ejecución vive en el anfitrión&lt;/b&gt;&lt;br&gt;Ahora: tu máquina fija.&lt;br&gt;Después: puede ser un servidor.&lt;br&gt;&lt;br&gt;Cerrar el navegador no cancela.&lt;br&gt;Abres otro PC y recuperas el estado." style="text;whiteSpace=wrap;html=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="280" height="160" as="geometry"/></mxCell>
        <mxCell id="explore_note" value="Solo lectura.&lt;br&gt;Se comparan alternativas&lt;br&gt;antes de decidir el plan." style="text;whiteSpace=wrap;html=1;fontSize=12;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="160" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="plan_note" value="Puedes comentar y ajustar&lt;br&gt;el plan en varias interacciones.&lt;br&gt;Solo tu aprobación permite avanzar." style="text;whiteSpace=wrap;html=1;fontSize=12;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="280" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="build_note" value="Ejecuta un modelo económico.&lt;br&gt;Si hay un bloqueo: pausa,&lt;br&gt;avisa y espera tu decisión." style="text;whiteSpace=wrap;html=1;fontSize=12;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="520" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="changes_note" value="Puedes comentar o editar líneas.&lt;br&gt;El LLM revisa tu parche&lt;br&gt;antes de aprobar los cambios." style="text;whiteSpace=wrap;html=1;fontSize=12;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="640" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="tickets_note" value="Cada caso muestra líneas y solución.&lt;br&gt;¿No lo entiendes? Abres su chat.&lt;br&gt;Conversar no autoriza correcciones." style="text;whiteSpace=wrap;html=1;fontSize=12;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="fix_note" value="Ejecuta un modelo económico.&lt;br&gt;Si no hay soluciones autorizadas,&lt;br&gt;se omite esta ejecución." style="text;whiteSpace=wrap;html=1;fontSize=12;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="finish_note" value="Se retiran los TODO temporales.&lt;br&gt;Se conservan artefactos,&lt;br&gt;decisiones y commits del workflow." style="text;whiteSpace=wrap;html=1;fontSize=12;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="1360" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="explore" target="plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Plan aprobado" edge="1" parent="1" source="plan" target="todo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="todo" target="build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="build" target="changes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Cambios aprobados" edge="1" parent="1" source="changes" target="qa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="qa" target="tickets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Casos decididos" edge="1" parent="1" source="tickets" target="qa_todo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="qa_todo" target="fix" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="fix" target="another_qa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="No" edge="1" parent="1" source="another_qa" target="finish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="Sí" edge="1" parent="1" source="another_qa" target="qa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;jettySize=60;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
